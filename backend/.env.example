# Django Settings
DJANGO_SECRET_KEY=your-secure-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*

# Groq LLM API Key (required for Medibot)
GROQ_API_KEY=your_groq_api_key_here
